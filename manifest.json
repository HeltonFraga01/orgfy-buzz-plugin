{
  "id": "digital.cortexx.orgfy",
  "name": "OrgFy Control Room",
  "apiVersion": 1,
  "description": "Painel de controle, governança determinística e orquestração autônoma da esteira OrgFy v10 para a Holding Cortexx.",
  "discovery": {
    "category": "developer-tools-and-integrations",
    "tags": [
      "OrgFy",
      "Cortexx",
      "Esteira",
      "Governance",
      "CI-CD",
      "Kanban",
      "Nostr"
    ]
  },
  "host": {
    "agentHooks": [
      "buzz.pi/pi",
      "buzz.claude-code/claude-code"
    ],
    "networkOrigins": [
      "https://api.cortexx.digital",
      "https://api.nexusmind.digital",
      "https://orgfy.communities.buzz.xyz"
    ],
    "files": true,
    "mcp": true,
    "processes": [
      {
        "id": "git",
        "program": "git",
        "args": []
      },
      {
        "id": "buzz",
        "program": "buzz",
        "args": []
      },
      {
        "id": "orgfy-kpis",
        "program": "python3",
        "args": ["ferramentas/esteira/gerar_kpis_esteira.py"]
      },
      {
        "id": "orgfy-loop-radar",
        "program": "python3",
        "args": ["ferramentas/esteira/goose_loop_radar.py"]
      }
    ],
    "commands": [
      {
        "id": "orgfy-status",
        "program": "python3",
        "args": ["ferramentas/esteira/quadro.py", "--json"],
        "maxOutputBytes": 131072
      },
      {
        "id": "fabrica-status",
        "program": "python3",
        "args": ["ferramentas/esteira/fabrica_status.py", "--json"],
        "maxOutputBytes": 262144
      },
      {
        "id": "orgfy-kpis",
        "program": "python3",
        "args": ["ferramentas/esteira/gerar_kpis_esteira.py"],
        "maxOutputBytes": 131072
      },
      {
        "id": "orgfy-loop-radar",
        "program": "python3",
        "args": ["ferramentas/esteira/goose_loop_radar.py"],
        "maxOutputBytes": 131072
      }
    ]
  }
}
